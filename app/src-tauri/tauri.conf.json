{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HandPulse",
  "version": "0.9.2",
  "identifier": "com.handpulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "手脉 HandPulse",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "HandPulse",
    "copyright": "Copyright © 2026 HandPulse",
    "category": "Utility",
    "shortDescription": "本地键鼠使用分析",
    "longDescription": "HandPulse 在本地统计键盘与鼠标的聚合使用情况，不联网、不读取输入内容、不记录按键顺序。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
